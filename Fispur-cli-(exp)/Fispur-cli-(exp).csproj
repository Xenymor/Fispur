<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Fispur_cli_exp</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- OpenBench builds via `make EXE=<name>`, which needs the binary to carry that
         exact name. A plain -p:AssemblyName= would also rename the referenced Fispur
         project (global properties propagate), so the rename goes through OB_EXE,
         which only this project reads. -->
    <AssemblyName Condition="'$(OB_EXE)' != ''">$(OB_EXE)</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fispur\Fispur.csproj" />
  </ItemGroup>

  <!-- OpenBench build: the Makefile publishes into a scratch folder (never the repo root,
       see there) and this copies the single published file into the repo root, where the
       worker expects <OB_EXE>[.exe]. The Copy task needs no shell tools, which Windows
       workers lack. -->
  <Target Name="CopyOpenBenchBinary" AfterTargets="Publish" Condition="'$(OB_EXE)' != ''">
    <ItemGroup>
      <_OpenBenchBinary Include="$(PublishDir)$(AssemblyName).exe" Condition="Exists('$(PublishDir)$(AssemblyName).exe')" />
      <_OpenBenchBinary Include="$(PublishDir)$(AssemblyName)" Condition="Exists('$(PublishDir)$(AssemblyName)')" />
    </ItemGroup>
    <Error Condition="'@(_OpenBenchBinary)' == ''" Text="OpenBench: published binary $(AssemblyName) not found in $(PublishDir)" />
    <Copy SourceFiles="@(_OpenBenchBinary)" DestinationFolder="$(MSBuildProjectDirectory)\.." />
  </Target>

</Project>
